# Copia este archivo a `.env` (no se sube a Git) y rellena tus propios valores.

# Cadena de conexión de MongoDB (local o Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/palamarket

# Secreto para firmar la sesión: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Puerto del servidor local (el frontend lo consume a través del proxy de Vite).
PORT=4000

# Orígenes del frontend autorizados (separados por comas).
# En producción: el dominio real, por ejemplo https://palamarket.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionales
# JWT_EXPIRES_IN=7d
# COOKIE_MAX_AGE_DAYS=7
# COOKIE_SAME_SITE=lax        # lax (mismo dominio, recomendado) | strict | none (backend en otro dominio)
# TRUST_PROXY=1               # número de proxies delante de la API (por defecto 1 en producción)
# AUTH_RATE_LIMIT_MAX=10      # intentos de registro/login por IP cada 15 minutos
# API_RATE_LIMIT_MAX=300
